{
  "name": "nailoong-blonde",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "blonde (Nailoong edition) — a touchable real-time 3D soft-body album cover",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "model": ".venv/bin/python tools/measure_ref.py && .venv/bin/python tools/model/build.py",
    "model:setup": "uv venv --python 3.11 .venv && uv pip install --python .venv/bin/python -r tools/requirements.txt",
    "test:visual": "node tests/visual.mjs",
    "test:e2e": "node tests/e2e.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "@fontsource/inter-tight": "^5.3.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "playwright": "^1.65.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.7"
  }
}
