{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "bundler", "lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker"],
    "strict": true, "noEmit": true, "skipLibCheck": true, "allowImportingTsExtensions": true, "resolveJsonModule": true,
    "isolatedModules": true, "verbatimModuleSyntax": false, "types": ["vite/client"]
  },
  "include": ["src"]
}
